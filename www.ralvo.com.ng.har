            "mimeType": "text/css",
            "text": ":root{--purple-900:#26215c;--purple-800:#393185;--purple-700:#463da6;--purple-600:#534ab7;--purple-500:#6960c9;--purple-400:#7f77dd;--purple-300:#9791e5;--purple-200:#afa9ec;--purple-100:#d8d5f6;--purple-50:#eeedfe;--teal-900:#04342c;--teal-600:#0f6e56;--teal-400:#1d9e75;--teal-200:#5dcaa5;--teal-50:#e1f5ee;--ink:#26215c;--body:#4a4770;--muted:#8b87b0;--paper:#fbfaff;--white:#fff;--display:\"Fraunces\", serif;--sans:\"Inter\", sans-serif}*{box-sizing:border-box;margin:0;padding:0}html,body{width:100%;overflow-x:hidden}body{font-family:var(--sans);color:var(--body);background:var(--paper);-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale;margin:0;line-height:1.6}h1,h2,h3,h4,h5,h6{font-family:var(--display);color:var(--ink);margin:0;font-weight:600}a{color:var(--purple-600);text-decoration:none}a:focus-visible,button:focus-visible,input:focus-visible,.btn:focus-visible,[tabindex]:focus-visible{outline:2px solid var(--teal-400);outline-offset:4px;border-radius:4px}.btn:focus-visible{border-radius:999px}a:hover{text-decoration:underline}:focus-visible{box-shadow:0 0 0 3px var(--purple-100), 0 0 0 1px var(--purple-400);border-radius:4px;outline:none}button:focus-visible,input:focus-visible,textarea:focus-visible{border-radius:inherit}::-webkit-scrollbar{width:8px;height:8px}::-webkit-scrollbar-track{background:0 0}::-webkit-scrollbar-thumb{background:#d1cedf;border-radius:10px}::-webkit-scrollbar-thumb:hover{background:#a5a0c3}button,input,textarea,select{font-family:inherit}.btn{font-family:var(--sans);cursor:pointer;border:1.5px solid #0000;border-radius:999px;align-items:center;gap:8px;padding:13px 26px;font-size:14px;font-weight:600;text-decoration:none;transition:transform .15s,background .15s,border-color .15s;display:inline-flex}.btn:hover{text-decoration:none;transform:translateY(-1px)}.btn-solid-purple{background:var(--purple-600);color:var(--white)}.btn-solid-purple:hover{background:var(--purple-900)}.btn-outline-teal{border-color:var(--teal-400);color:var(--teal-900);background:0 0}.btn-outline-teal:hover{background:var(--teal-50)}.btn-outline-white{color:var(--white);background:0 0;border-color:#ffffff80}.btn-outline-white:hover{background:#ffffff1a}.btn-solid-teal{background:var(--teal-400);color:var(--teal-900)}.btn-solid-teal:hover{background:var(--teal-200)}.text-display{font-family:var(--display)}.text-sans{font-family:var(--sans)}section.block{padding:96px 32px}@media (width<=768px){section.block{padding:64px 16px}}section.block.alt{background:var(--white)}.eyebrow{letter-spacing:.12em;text-transform:uppercase;color:var(--teal-600);font-size:12px;font-weight:600}.section-title{max-width:640px;margin-top:10px;font-size:34px}.section-lede{color:var(--body);max-width:640px;margin-top:16px;font-size:16px}@keyframes slideDownFade{0%{opacity:0;transform:translateY(-10px)}to{opacity:1;transform:translateY(0)}}.auth-error-popup{color:var(--pink-700);background-color:var(--pink-50);border:1px solid var(--pink-100);border-radius:8px;align-items:center;gap:8px;margin-bottom:20px;padding:12px 16px;font-size:14px;font-weight:500;animation:.3s cubic-bezier(.16,1,.3,1) forwards slideDownFade;display:flex}.auth-error-popup:before{content:\"!\";background-color:var(--pink-600);color:#fff;border-radius:50%;flex-shrink:0;justify-content:center;align-items:center;width:18px;height:18px;font-size:12px;font-weight:700;display:flex}.premium-form-group{flex-direction:column;gap:8px;display:flex}.premium-label{color:var(--ink);text-transform:uppercase;letter-spacing:.05em;font-size:13px;font-weight:700;display:block}.premium-input{width:100%;color:var(--ink);background-color:var(--white);font-size:15px;font-family:var(--sans);border:1.5px solid #e4e1f5;border-radius:12px;outline:none;padding:14px 18px;transition:all .2s}.premium-input::placeholder{color:#a5a0c3;font-weight:400}.premium-input:hover{border-color:#d1cedf}.premium-input:focus{border-color:var(--purple-400);box-shadow:0 0 0 4px var(--pur